{
  "name": "oficina",
  "version": "1.0.0",
  "description": "Espacio creativo personal desarrollado desde Android con UserLAnd, Node.js, Three.js y TSL.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently -k \"node server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "catalogo:dibujos": "node scripts/generate-drawings-manifest.mjs",
    "predev": "npm run catalogos",
    "prebuild": "npm run catalogos",
    "catalogo:musica": "node scripts/generate-music-manifest.mjs",
    "catalogos": "npm run catalogo:dibujos && npm run catalogo:musica"
  },
  "repository": {
    "type": "git",
