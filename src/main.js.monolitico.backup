import * as THREE from 'three';
import { WebGPURenderer, MeshStandardNodeMaterial } from 'three/webgpu';
import { color, mix, uv } from 'three/tsl';

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x030611);
scene.fog = new THREE.FogExp2(0x030611, 0.025);

const camera = new THREE.PerspectiveCamera(
  55, window.innerWidth / window.innerHeight, 0.1, 100
);
camera.position.set(0, 3.2, 8.5);
camera.lookAt(0, 1.5, 0);

// Materiales
const metal = new THREE.MeshStandardMaterial({
  color: 0x101827,
  metalness: 0.85,
  roughness: 0.3
});

const floorMaterial = new THREE.MeshStandardMaterial({
  color: 0x080e1b,
  metalness: 0.65,
  roughness: 0.28
});

const blueLine = new THREE.MeshBasicMaterial({ color: 0x087fff });
const goldLine = new THREE.MeshBasicMaterial({ color: 0xffc45c });

// Sala pentagonal
const radius = 5;
const vertices = [];

for (let i = 0; i < 5; i++) {
  const a = (i / 5) * Math.PI * 2;
  vertices.push(new THREE.Vector2(
    Math.sin(a) * radius,
    Math.cos(a) * radius
  ));
}

const floorShape = new THREE.Shape();
floorShape.moveTo(vertices[0].x, vertices[0].y);
for (let i = 1; i < 5; i++) {
  floorShape.lineTo(vertices[i].x, vertices[i].y);
}
floorShape.closePath();

const floor = new THREE.Mesh(
  new THREE.ShapeGeometry(floorShape),
  floorMaterial
);
floor.rotation.x = -Math.PI / 2;
floor.position.y = 0;
floor.geometry.computeVertexNormals();
scene.add(floor);

// Paredes angulares. La parte delantera queda abierta
// para ver la sala y tocar las esferas.
const wallHeight = 4.5;
const wallThickness = 0.18;

for (let i = 0; i < 5; i++) {
  const a = vertices[i];
  const b = vertices[(i + 1) % 5];
  const midX = (a.x + b.x) / 2;
  const midZ = (a.y + b.y) / 2;

  // Entrada abierta hacia la cámara
  if (midZ > 0.1) continue;

  const dx = b.x - a.x;
  const dz = b.y - a.y;
  const length = Math.hypot(dx, dz);
  const angle = Math.atan2(-dz, dx);

  const wall = new THREE.Mesh(
    new THREE.BoxGeometry(length, wallHeight, wallThickness),
    metal
  );
  wall.position.set(midX, wallHeight / 2, midZ);
  wall.rotation.y = angle;
  scene.add(wall);

  // Línea luminosa en la parte superior de cada pared
  const trim = new THREE.Mesh(
    new THREE.BoxGeometry(length, 0.035, 0.035),
    i % 2 === 0 ? goldLine : blueLine
  );
  trim.position.set(midX, wallHeight - 0.15, midZ);
  trim.rotation.y = angle;
  scene.add(trim);
}

// Columnas en los vértices
for (let i = 0; i < 5; i++) {
  const v = vertices[i];
  if (v.y > 1.5) continue;

  const pillar = new THREE.Mesh(
    new THREE.BoxGeometry(0.16, wallHeight, 0.16),
    metal
  );
  pillar.position.set(v.x, wallHeight / 2, v.y);
  scene.add(pillar);

  const glow = new THREE.Mesh(
    new THREE.BoxGeometry(0.19, 0.035, 0.19),
    i % 2 === 0 ? blueLine : goldLine
  );
  glow.position.set(v.x, wallHeight - 0.3, v.y);
  scene.add(glow);
}

// Líneas geométricas en el suelo
for (let i = 0; i < 5; i++) {
  const a = vertices[i];
  const b = vertices[(i + 1) % 5];

  const points = [
    new THREE.Vector3(a.x * 0.88, 0.025, a.y * 0.88),
    new THREE.Vector3(b.x * 0.88, 0.025, b.y * 0.88)
  ];

  const line = new THREE.Mesh(
    new THREE.BufferGeometry().setFromPoints(points),
    i % 2 === 0 ? blueLine : goldLine
  );
  scene.add(line);
}

// Iluminación cinematográfica
scene.add(new THREE.HemisphereLight(0x83bfff, 0x08091c, 2));

const keyLight = new THREE.DirectionalLight(0xffd39a, 2.5);
keyLight.position.set(3, 5, 4);
scene.add(keyLight);

const blueLight = new THREE.PointLight(0x087fff, 18, 12);
blueLight.position.set(-2, 3, 1);
scene.add(blueLight);

const goldLight = new THREE.PointLight(0xffb94f, 9, 10);
goldLight.position.set(3, 2, -3);
scene.add(goldLight);

// Plataforma central
const platform = new THREE.Mesh(
  new THREE.CylinderGeometry(1.5, 1.65, 0.12, 64),
  metal
);
platform.position.set(0, 0.09, 0);
scene.add(platform);

const platformRing = new THREE.Mesh(
  new THREE.TorusGeometry(1.48, 0.025, 8, 96),
  blueLine
);
platformRing.rotation.x = Math.PI / 2;
platformRing.position.y = 0.17;
scene.add(platformRing);

// Tres esferas-botón con material TSL
const buttonMaterial = new MeshStandardNodeMaterial({
  colorNode: mix(
    color(0x06142d),
    color(0x087fff),
    uv().y
  ),
  roughness: 0.24,
  metalness: 0.45
});

const buttonGeometry = new THREE.SphereGeometry(0.4, 48, 32);
const buttons = [];
const buttonNames = ['PERFIL', 'PROYECTOS', 'AJUSTES'];

for (let i = 0; i < 3; i++) {
  const x = (i - 1) * 1.35;

  const sphere = new THREE.Mesh(buttonGeometry, buttonMaterial);
  sphere.position.set(x, 1.8, 0.25);
  sphere.userData.buttonIndex = i;
  sphere.userData.baseY = 1.8;
  sphere.userData.phase = i * 2.1;
  scene.add(sphere);

  const halo = new THREE.Mesh(
    new THREE.TorusGeometry(0.49, 0.012, 8, 64),
    i === 1 ? goldLine : blueLine
  );
  halo.position.copy(sphere.position);
  halo.userData.buttonIndex = i;
  scene.add(halo);

  buttons.push({ sphere, halo, name: buttonNames[i] });
}

// Indicador visual del backend
const backendLabel = document.createElement('div');
backendLabel.style.cssText =
  'position:fixed;top:12px;left:12px;z-index:10;' +
  'padding:8px 11px;border:1px solid #1765a0;' +
  'border-radius:8px;font:12px monospace;color:#83cfff;' +
  'background:rgba(3,6,17,.88);pointer-events:none;';
backendLabel.textContent = 'INICIALIZANDO WEBGPU';
document.body.appendChild(backendLabel);

// Mensaje de interacción
const message = document.createElement('div');
message.style.cssText =
  'position:fixed;left:50%;bottom:28px;transform:translateX(-50%);' +
  'z-index:10;padding:12px 18px;border:1px solid #168cff;' +
  'border-radius:12px;background:rgba(3,10,27,.94);' +
  'color:#d9efff;font:14px monospace;text-align:center;' +
  'max-width:85%;pointer-events:none;opacity:0;' +
  'transition:opacity .2s;';
message.textContent = 'Selecciona una esfera';
document.body.appendChild(message);

document.body.style.margin = '0';
document.body.style.overflow = 'hidden';
document.body.style.background = '#030611';
document.body.style.touchAction = 'none';

const renderer = new WebGPURenderer({ antialias: true });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));

renderer.domElement.style.width = '100%';
renderer.domElement.style.height = '100%';
renderer.domElement.style.display = 'block';
document.body.insertBefore(renderer.domElement, backendLabel);

const raycaster = new THREE.Raycaster();
const pointer = new THREE.Vector2();
let messageTimeout;

renderer.domElement.addEventListener('pointerdown', (event) => {
  const rect = renderer.domElement.getBoundingClientRect();
  pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
  pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

  raycaster.setFromCamera(pointer, camera);
  const hits = raycaster.intersectObjects(
    buttons.map((button) => button.sphere)
  );

  if (hits.length > 0) {
    const selected = buttons[hits[0].object.userData.buttonIndex];
    message.textContent = selected.name + ' · SELECCIONADO';
    message.style.opacity = '1';

    clearTimeout(messageTimeout);
    messageTimeout = setTimeout(() => {
      message.style.opacity = '0';
    }, 1800);
  }
});

window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

async function start() {
  await renderer.init();
  renderer.setSize(window.innerWidth, window.innerHeight);

  const backend = renderer.backend;
  backendLabel.textContent =
    backend?.isWebGPUBackend === true ? 'BACKEND: WEBGPU' :
    backend?.isWebGLBackend === true ? 'BACKEND: WEBGL2' :
    'BACKEND: NO IDENTIFICADO';

  const timer = new THREE.Timer();

  renderer.setAnimationLoop(() => {
    timer.update();
    const t = timer.getElapsed();

    buttons.forEach(({ sphere, halo }, i) => {
      const phase = t * 1.2 + sphere.userData.phase;
      sphere.position.y =
        sphere.userData.baseY + Math.sin(phase) * 0.12;

      sphere.rotation.y = t * 0.35;
      halo.position.y = sphere.position.y;
      halo.rotation.z = t * 0.25 + i;
    });

    platformRing.rotation.z = t * 0.18;
    blueLight.intensity = 16 + Math.sin(t * 1.8) * 3;

    renderer.render(scene, camera);
  });
}

start().catch((error) => {
  console.error(error);
  backendLabel.textContent = 'ERROR AL INICIAR WEBGPU';
});
